# Copy to .env on the VM and fill in real values.
#   cp .env.example .env

# Public hostname that points to this VM (A/AAAA DNS record)
DOMAIN=chat.example.com
ACME_EMAIL=you@example.com

# Strong secrets — generate with:
#   openssl rand -base64 32
POSTGRES_USER=aegis
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=aegis
JWT_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM

# Tauri desktop origins (keep these). Add browser origins if you ever host a web UI.
CORS_ORIGIN=http://tauri.localhost,https://tauri.localhost,tauri://localhost

ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
# 2GB per file (aligned with Windows client). Disk is still the hard limit.
MAX_UPLOAD_BYTES=2147483648

# Set to 1 only on the very first boot if you want auto-seed (admin/changeme123).
# Prefer: docker compose exec api npx tsx src/seed.ts
RUN_SEED=0

# Optional — Game Hosting start/stop via Pterodactyl Client API
# PTERODACTYL_URL=https://panel.example.com
# PTERODACTYL_CLIENT_KEY=ptlc_xxxxxxxx

# Optional — AI Chat via Ollama (LAN). Use host LAN IP if Ollama is not in Docker.
# OLLAMA_URL=http://192.168.1.235:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_MS=120000
