DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegis
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=3001
# Include Tauri origins so the desktop app can call the API
CORS_ORIGIN=http://localhost:8765,http://127.0.0.1:8765,http://localhost:1420,http://localhost:5173,http://tauri.localhost,https://tauri.localhost,tauri://localhost
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
UPLOAD_DIR=./uploads
# 2GB (aligned with client + LAN deploy)
MAX_UPLOAD_BYTES=2147483648
# Production: NODE_ENV=production requires JWT_SECRET + DATABASE_URL (no weak defaults)
# Optional Pterodactyl (game hosting power control)
# PTERODACTYL_URL=https://panel.example.com
# PTERODACTYL_CLIENT_KEY=ptlc_xxxxxxxx
# Optional Ollama (AI Chat module)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_MS=120000
